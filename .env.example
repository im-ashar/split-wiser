# Splitwise OAuth app credentials (https://secure.splitwise.com/oauth_clients)
SPLITWISE_CLIENT_ID=your-client-id
SPLITWISE_CLIENT_SECRET=your-client-secret

# Must exactly match the redirect registered in your Splitwise app.
# Local dev: http://localhost:5173/auth/callback
# Production: https://<your-site>.netlify.app/auth/callback
SPLITWISE_REDIRECT_URI=http://localhost:5173/auth/callback

# 32+ random bytes, base64-encoded. Generate with: openssl rand -base64 32
SESSION_COOKIE_SECRET=replace-me-with-a-32-byte-base64-secret

# Public-safe absolute URL of the deployed app (used in og:meta etc.)
PUBLIC_APP_URL=http://localhost:5173
